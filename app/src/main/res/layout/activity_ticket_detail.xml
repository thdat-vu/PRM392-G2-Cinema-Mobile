<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chi Tiết Vé"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/ticket_detail_movie_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Movie Title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/ticket_detail_theatre_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Theatre Name"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/ticket_detail_showtime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Showtime"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/ticket_detail_seats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seats"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/ticket_detail_booking_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Booking Code"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/ticket_detail_total_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Amount"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đồ Ăn"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/ticket_detail_food_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Food Items"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>